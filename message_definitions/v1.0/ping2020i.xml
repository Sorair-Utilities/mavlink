      </enum>

      <enum name="UAVIONIX_ADSB_OUT_OWNERSHIP_EMERGENCY_STATUS">
        <entry value="0" name="UAVIONIX_ADSB_OUT_EMERGENCY_NONE"/>
        <entry value="1" name="UAVIONIX_ADSB_OUT_EMERGENCY_GENERAL"/>
        <entry value="2" name="UAVIONIX_ADSB_OUT_EMERGENCY_LIFEGUARD"/>
        <entry value="3" name="UAVIONIX_ADSB_OUT_EMERGENCY_MIN_FUEL"/>
        <entry value="4" name="UAVIONIX_ADSB_OUT_EMERGENCY_NO_COMM"/>
        <entry value="5" name="UAVIONIX_ADSB_OUT_EMERGENCY_UNLAWFUL_INTERFERENCE"/>
        <entry value="6" name="UAVIONIX_ADSB_OUT_EMERGENCY_DOWNED_AIRCRAFT"/>
        <entry value="7" name="UAVIONIX_ADSB_OUT_EMERGENCY_RESERVED"/>
      </enum>

    <enum name="UAVIONIX_ADSB_OUT_STATUS" bitmask="true">
      <description>Status flags indicating transceiver self-test results</description>
      <entry value="0x00" name="UAVIONIX_ADSB_OUT_STATUS_INITIALIZING" />
      <entry value="0x01" name="UAVIONIX_ADSB_OUT_STATUS_OK" />
      <entry value="0x02" name="UAVIONIX_ADSB_OUT_STATUS_TX_FAIL_1090ES" />
      <entry value="0x04" name="UAVIONIX_ADSB_OUT_STATUS_RX_FAIL_1090ES" />
      <entry value="0x08" name="UAVIONIX_ADSB_OUT_STATUS_TX_FAIL_UAT" />
      <entry value="0x10" name="UAVIONIX_ADSB_OUT_STATUS_RX_FAIL_UAT" />
    </enum>

  </enums>

  <messages>

