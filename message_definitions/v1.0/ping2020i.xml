      </enum>

      <enum name="UAVIONIX_ADSB_OUT_FIX_TYPE">
        <description>GPS fix types for dynamic report</description>
        <entry value="0x00" name="UAVIONIX_ADSB_OUT_GPS_NO_FIX_0"/>
        <entry value="0x01" name="UAVIONIX_ADSB_OUT_GPS_NO_FIX_1"/>
        <entry value="0x02" name="UAVIONIX_ADSB_OUT_GPS_2D_FIX"/>
        <entry value="0x03" name="UAVIONIX_ADSB_OUT_GPS_3D_FIX"/>
        <entry value="0x04" name="UAVIONIX_ADSB_OUT_GPS_DGPS"/>
