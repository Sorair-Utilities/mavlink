<?xml version="1.0"?>
<mavlink>

  <dialect>ping2020i</dialect>

  <include>uAvionix.xml</include>

  <!-- Enums -->
  <enums>

    <enum name="PING2020I_DYNAMIC_STATE" bitmask="true">
      <description>ADS-B transponder dynamic state flags</description>
      <entry value="0x01" name="PING2020I_ADSB_DYNAMIC_STATE_INTENT_CHANGE"/>
      <entry value="0x02" name="PING2020I_ADSB_DYNAMIC_STATE_AUTOPILOT_ENABLED"/>
      <entry value="0x04" name="PING2020I_ADSB_DYNAMIC_STATE_NICBARO_CROSSCHECKED"/>
      <entry value="0x08" name="PING2020I_ADSB_DYNAMIC_STATE_ON_GROUND"/>
      <entry value="0x10" name="PING2020I_ADSB_DYNAMIC_STATE_IDENT"/>
    </enum>

    <enum name="PING2020I_OWNERSHIP_CONTROL" bitmask="true">
      <entry value="0" name="CONTROL_STANDBY"/>
      <entry value="1" name="CONTROL_RECEIVE_ONLY"/>
      <entry value="2" name="CONTROL_TX_ENABLE_1090"/>
      <entry value="4" name="CONTROL_TX_ENABLE_UAT"/>
      <entry value="8" name="CONTROL_MODE_A_ENABLED"/>
      <entry value="16" name="CONTROL_MODE_C_ENABLED"/>
      <entry value="32" name="CONTROL_MODE_S_ENABLED"/>
    </enum>

    <enum name="PING2020I_FIX_TYPE">
      <description>GPS fix types for dynamic report</description>
      <entry value="0x00" name="PING2020I_ADSB_GPS_NO_FIX_0"/>
      <entry value="0x01" name="PING2020I_ADSB_GPS_NO_FIX_1"/>
      <entry value="0x02" name="PING2020I_ADSB_GPS_2D_FIX"/>
      <entry value="0x03" name="PING2020I_ADSB_GPS_3D_FIX"/>
      <entry value="0x04" name="PING2020I_ADSB_GPS_DGPS"/>
      <entry value="0x05" name="PING2020I_ADSB_GPS_RTK"/>
    </enum>

    <enum name="PING2020I_OWNERSHIP_EMERGENCY_STATUS">
      <entry value="0" name="EMERGENCY_NONE"/>
      <entry value="1" name="EMERGENCY_GENERAL"/>
      <entry value="2" name="EMERGENCY_LIFEGUARD"/>
      <entry value="3" name="EMERGENCY_MIN_FUEL"/>
      <entry value="4" name="EMERGENCY_NO_COMM"/>
      <entry value="5" name="EMERGENCY_UNLAWFUL_INTERFERENCE"/>
      <entry value="6" name="EMERGENCY_DOWNED_AIRCRAFT"/>
      <entry value="7" name="EMERGENCY_RESERVED"/>
    </enum>

  <enum name="PING2020I_STATUS_FLAGS" bitmask="true">
    <description>Status flags indicating transceiver self-test results</description>
    <entry value="0x00" name="PING2020I_STATUS_INITIALIZING" />
    <entry value="0x01" name="PING2020I_STATUS_OK" />
    <entry value="0x02" name="PING2020I_STATUS_TX_FAIL_1090ES" />
    <entry value="0x04" name="PING2020I_STATUS_RX_FAIL_1090ES" />
    <entry value="0x08" name="PING2020I_STATUS_TX_FAIL_UAT" />
    <entry value="0x10" name="PING2020I_STATUS_RX_FAIL_UAT" />
  </enum>

  </enums>

  <messages>

  <!-- Messages -->
    <message id="202" name="PING2020I_OWNERSHIP_REPORT">
      <description>Dynamic / Ownship message from Ping transceiver</description>
      <field type="uint32_t" name="utcTime" units="s">UTC time in seconds since GPS epoch (Jan 6, 1980)</field>
      <field type="int32_t" name="latitude" units="degE7">Latitude WGS84</field>
      <field type="int32_t" name="longitude" units="degE7">Longitude WGS84</field>
      <field type="int32_t" name="altPres" units="m*1E3">Barometric pressure altitude</field>
      <field type="int32_t" name="altGNSS" units="m*1E3">GNSS altitude</field>
      <field type="uint32_t" name="accHoriz" units="mm">Horizontal accuracy (HFOM)</field>
      <field type="uint16_t" name="accVert" units="cm">Vertical accuracy (VFOM)</field>
      <field type="uint16_t" name="accVel" units="mm/s">Velocity accuracy</field>
      <field type="int16_t" name="velVert" units="m/s * 1E2">Vertical speed</field>
      <field type="int16_t" name="nsVog" units="m/s * 1E2">North-South velocity</field>
      <field type="int16_t" name="ewVog" units="m/s * 1E2">East-West velocity</field>
      <field type="uint16_t" name="state" enum="PING2020I_DYNAMIC_STATE">Dynamic state flags</field>
      <field type="uint16_t" name="squawk">Squawk code (Mode A)</field>
      <field type="uint8_t" name="fixType" enum="PING2020I_FIX_TYPE">GPS Fix Type</field>
      <field type="uint8_t" name="numSats">Number of satellites</field>
      <field type="uint8_t" name="emStatus" enum="PING2020I_OWNERSHIP_EMERGENCY_STATUS">Emergency status</field>
      <field type="uint8_t" name="control" enum="PING2020I_OWNERSHIP_CONTROL">ADS-B transponder dynamic input control flags</field>
    </message>

    <message id="201" name="PING2020I_STATIC">
      <description>Static configuration message for Ping transceiver</description>
      <field type="uint32_t" name="icao_address">ICAO Address</field>
      <field type="char[8]" name="callsign">Aircraft callsign (null-terminated)</field>
      <field type="uint8_t" name="emitter_type">Emitter type</field>
      <field type="uint8_t" name="aircraft_size">Aircraft size</field>
      <field type="uint8_t" name="gps_offset_lat">GPS lateral offset</field>
      <field type="uint8_t" name="gps_offset_lon">GPS longitudinal offset</field>
      <field type="uint16_t" name="stall_speed" units="cm/s">Stall speed</field>
      <field type="uint8_t" name="rf_select">RF control flags</field>
    </message>

    <message id="203" name="PING2020I_STATUS">
      <description>Self-test status message</description>
      <field type="uint8_t" name="status" enum="PING2020I_STATUS_FLAGS">Self test status</field>
    </message>


    <message id="248" name="PING2020I_IDENTIFICATION">
      <description>Identification Message from Ping device</description>

      <field type="uint16_t" name="message_type">Message Type</field>
      <field type="uint8_t" name="target_network">Network ID</field>
      <field type="uint8_t" name="target_system">System ID</field>
      <field type="uint8_t" name="target_component">Component ID</field>

      <field type="uint8_t" name="primaryMajorVersion">Primary Image Major Version</field>
      <field type="uint8_t" name="primaryMinorVersion">Primary Image Minor Version</field>
      <field type="uint8_t" name="primaryBuildVersion">Primary Image Build Version</field>
      <field type="uint8_t" name="primaryFwId">Primary Image FW Identifier</field>
      <field type="uint8_t" name="primaryHwId">Primary HW identifier</field>
      <field type="uint64_t" name="primarySerialNumber">Primary Serial Number</field>
      <field type="uint32_t" name="primaryCRC">Primary CRC</field>
      <field type="uint8_t[15]" name="primaryFwPartNumber">Primary FW Part Number</field>

      <field type="uint8_t" name="secondaryMajorVersion">Secondary Image Major Version</field>
      <field type="uint8_t" name="secondaryMinorVersion">Secondary Image Minor Version</field>
      <field type="uint8_t" name="secondaryBuildVersion">Secondary Image Build Version</field>
      <field type="uint8_t" name="secondaryFwId">Secondary FW Identifier</field>
      <field type="uint8_t" name="secondaryHwId">Secondary HW Identifier</field>
      <field type="uint64_t" name="secondarySerialNumber">Secondary Serial Number</field>
      <field type="uint32_t" name="secondaryCRC">Secondary CRC</field>
      <field type="uint8_t[15]" name="secondaryFwPartNumber">Secondary FW Part Number</field>
    </message>

  </messages>
</mavlink>
