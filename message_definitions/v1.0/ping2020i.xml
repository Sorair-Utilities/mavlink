    <message id="201" name="UAVIONIX_ADSB_OUT_STATIC">
      <description>Static configuration message for UAVIONIX ADS-B Out transceiver</description>
      <field type="uint8_t[3]" name="icao_address">Vehicle address (24 bits). Byte[2] = msByte</field>
      <field type="uint8_t" name="integrity">System Integrity and Design Assurance</field>
      <field type="uint16_t" name="stall_speed" units="cm/s">Aircraft stall speed in cm/s</field>
      <field type="char[8]" name="callsign">Vehicle identifier (8 characters, valid characters are A-Z, 0-9, " " only)</field>
      <field type="uint8_t" name="capability">Max Aircraft Speed and ADS-B in capability</field>
      <field type="uint8_t" name="emitter">Transmitting vehicle type</field>
      <field type="uint8_t" name="alwEncode">Aircraft length and width encoding (table 2-35 of DO-282B)</field>
      <field type="uint8_t" name="gpsLatOffs">GPS antenna lateral offset (table 2-36 of DO-282B)</field>
      <field type="uint8_t" name="gpsLonOffs">GPS antenna longitudinal offset from nose [if non-zero, take position (in meters) divide by 2 and add one with max 60m] (table 2-37 DO-282B)</field>
    </message>


    <message id="203" name="UAVIONIX_ADSB_OUT_STATUS">
      <description>Self test status.</description>
      <field type="uint8_t" name="status" enum="UAVIONIX_ADSB_OUT_STATUS">Self test status</field>
    </message>


    <message id="248" name="UAVIONIX_ADSB_OUT_IDENTIFICATION">
      <description>Identification Message from UAVIONIX ADS-B Out device</description>

      <field type="uint16_t" name="message_type">Message Type</field>
      <field type="uint8_t" name="target_network">Network ID</field>
      <field type="uint8_t" name="target_system">System ID</field>
      <field type="uint8_t" name="target_component">Component ID</field>

      <field type="uint8_t" name="primaryMajorVersion">Primary Image Major Version</field>
      <field type="uint8_t" name="primaryMinorVersion">Primary Image Minor Version</field>
      <field type="uint8_t" name="primaryBuildVersion">Primary Image Build Version</field>
      <field type="uint8_t" name="primaryFwId">Primary Image FW Identifier</field>
      <field type="uint8_t" name="primaryHwId">Primary HW identifier</field>
      <field type="uint64_t" name="primarySerialNumber">Primary Serial Number</field>
      <field type="uint32_t" name="primaryCRC">Primary CRC</field>
      <field type="uint8_t[15]" name="primaryFwPartNumber">Primary FW Part Number</field>

      <field type="uint8_t" name="secondaryMajorVersion">Secondary Image Major Version</field>
      <field type="uint8_t" name="secondaryMinorVersion">Secondary Image Minor Version</field>
      <field type="uint8_t" name="secondaryBuildVersion">Secondary Image Build Version</field>
      <field type="uint8_t" name="secondaryFwId">Secondary FW Identifier</field>
      <field type="uint8_t" name="secondaryHwId">Secondary HW Identifier</field>
      <field type="uint64_t" name="secondarySerialNumber">Secondary Serial Number</field>
      <field type="uint32_t" name="secondaryCRC">Secondary CRC</field>
      <field type="uint8_t[15]" name="secondaryFwPartNumber">Secondary FW Part Number</field>
    </message>

    <message id="202" name="UAVIONIX_ADSB_OUT_NAVIGATION">
      <description>Dynamic / Ownship message from UAVIONIX ADS-B Out transceiver</description>
      <field type="uint32_t" name="utcTime_s" units="s" invalid="UINT32_MAX">UTC time since GPS epoch (in s since Jan 6, 1980). If unknown set to UINT32_MAX.</field>
      <field type="int32_t" name="latitude" units="degE7" invalid="INT32_MAX">Latitude WGS84 (deg * 1E7). If unknown set to INT32_MAX</field>
      <field type="int32_t" name="longitude" units="degE7" invalid="INT32_MAX">Longitude WGS84 (deg * 1E7). If unknown set to INT32_MAX.</field>
      <field type="int32_t" name="altHAE_mm" units="mm" invalid="INT32_MAX">Altitude (meters * 1E3) UP +ve. Height above WGS-84 ellipsoid. If unknown set to INT32_MAX. Saturates at INT32_MAX-1.</field>
      <field type="int32_t" name="altPres_mm" units="mm" invalid="INT32_MAX">Barometric pressure altitude (meters 1E3) UP +ve. If unknown set to INT32_MAX. Saturates at INT32_MAX-1.</field>
      <field type="uint32_t" name="horizontalPL_mm" units="mm" invalid="UINT32_MAX">Horizontal Protection Level (mm). If unknown set to UINT32_MAX. Saturates at UINT32_MAX-1. May report HPLsbas or HPLfd (see state bit 0x01).</field>
      <field type="uint32_t" name="verticalPL_mm" units="cm" invalid="UINT32_MAX">Vertical Protection Level (cm). If unknown set to UINT32_MAX. Saturates at UINT32_MAX-1. May report VPLsbas or VPLfd.</field>
      <field type="uint32_t" name="horizontalFOM_mm" units="mm" invalid="UINT32_MAX">Horizontal Figure of Merit, 95% (HFOM) (mm). If unknown set to UINT32_MAX. Saturates at UINT32_MAX-1.</field>
      <field type="uint16_t" name="verticalFOM_cm" units="cm" invalid="UINT16_MAX">Vertical Figure of Merit, 95% (VFOM) (cm). If unknown set to UINT16_MAX. Saturates at UINT16_MAX-1.</field>
      <field type="uint16_t" name="horizontalVelocityFOM_mmps" units="mm/s" invalid="UINT16_MAX">Horizontal Velocity Figure of Merit, 95% (HVFOM) (m/s * 1E3). If unknown set to UINT16_MAX. Saturates at UINT16_MAX-1.</field>
      <field type="uint16_t" name="verticalVelocityFOM_mmps" units="mm/s" invalid="UINT16_MAX">Vertical Velocity Figure of Merit, 95% (HVFOM) (m/s * 1E3). If unknown set to UINT16_MAX. Saturates at UINT16_MAX-1.</field>
      <field type="int16_t" name="verticalVelocity_cmps" units="cm/s" invalid="INT16_MAX">GNSS vertical speed (m/s * 1E2). If unknown set to INT16_MAX. Saturates at INT16_MAX-1. (positive ascending, negative descending)</field>
      <field type="int16_t" name="northVelocity_dmps" units="dm/s" invalid="INT16_MAX">North-South velocity over ground (m/s * 1E1) North +ve. If unknown set to INT16_MAX. Saturates at INT16_MAX-1.</field>
      <field type="int16_t" name="eastVelocity_dmps" units="dm/s" invalid="INT16_MAX">East-West velocity over ground (m/s * 1E1) East +ve. If unknown set to INT16_MAX. Saturates at INT16_MAX-1.</field>
      <field type="uint8_t" name="utcTimeFractional_cs" units="cs" invalid="UINT8_MAX">Time (ms * 1E1) since UTC time mark. If unknown set to UINT8_MAX.</field>
      <field type="uint8_t" name="fixType" invalid="UINT8_MAX">GNSS fix type, see table below. If unknown set to UINT8_MAX.</field>
      <field type="uint8_t" name="navState" invalid="UINT8_MAX">Navigation state, see table below. If unknown set to UINT8_MAX.</field>
      <field type="uint8_t" name="satsUsed" invalid="UINT8_MAX">Number of satellites in solution. Includes GNSS and GEO satellites. If unknown set to UINT8_MAX. Saturates at UINT8_MAX-1.</field>
      <field type="uint8_t" name="fwVersionMajor">Major FW version</field>
      <field type="uint8_t" name="fwVersionMinor">Minor FW version</field>
      <field type="uint8_t" name="fwVersionBuild">Build FW version</field>
    </message>
  </messages>
</mavlink>
